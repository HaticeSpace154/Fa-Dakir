{
  "appId": "com.Quran.fadakir",
  "appName": "تلاوة و ختم | Fa-dakir",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "hostname": "localhost"
  },
  "plugins": {
    "App": {
      "disableBackButtonHandler": true
    },
    "SplashScreen": {
      "launchShowDuration": 500,
      "launchAutoHide": true,
      "launchFadeOutDuration": 500,
      "backgroundColor": "#0A0D0E",
      "androidScaleType": "CENTER_CROP",
      "iosScaleType": "centerCrop",
      "useDialog": false
    }
  }
}
